# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────
# Always include the database name before the `?` — otherwise Mongoose silently uses `test`.
# Dev  — a dedicated -dev database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio-dev?retryWrites=true&w=majority&appName=Cluster0
# Prod (uncomment and swap when deploying)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority&appName=Cluster0

# ── CORS ────────────────────────────────────────────────────────────────
# Dev default — Vite dev server
CLIENT_ORIGIN=http://localhost:5173
# Prod
# CLIENT_ORIGIN=https://brandonmartins.co.za

# ── Email (optional in dev: submissions are stored and logged if SMTP is unset) ──
CONTACT_TO_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brandon Martins <hello@brandonmartins.co.za>"

# ── Spam protection ─────────────────────────────────────────────────────
# Leave empty in dev to skip the Turnstile check. Required in production.
TURNSTILE_SECRET=
IP_HASH_SALT=change-me
