{
	"name": "server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"predev": "npm run build -w @portfolio/shared",
		"dev": "tsx watch server.ts",
		"prebuild": "npm run build -w @portfolio/shared",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"pretypecheck": "npm run build -w @portfolio/shared",
		"typecheck": "tsc --noEmit",
		"pretest": "npm run build -w @portfolio/shared",
		"test": "vitest run"
	},
	"dependencies": {
		"@portfolio/shared": "*",
		"axios": "^1.21.1",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.5",
		"helmet": "^8.3.0",
		"mongoose": "^9.13.0",
		"nodemailer": "^10.6.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^22.0.0",
		"@types/nodemailer": "^8.0.2",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.3.2",
		"tsx": "^4.23.15"
	}
}
