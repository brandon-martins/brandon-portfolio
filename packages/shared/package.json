{
	"name": "@portfolio/shared",
	"private": true,
	"version": "0.1.0",
	"description": "Code shared by client and server: the contact schema and its types. Pure TypeScript + zod, no Node or DOM imports.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "^4.6.7"
	}
}
